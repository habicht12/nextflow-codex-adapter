plugins { id 'nf-agent-codex@0.1.1' }

params.model = 'openai/gpt-6-luna'
params.codex_home = "${env('HOME')}/.local/state/nf-agent-codex"

docker.enabled = true
agent {
    runner = 'codex'
    model = params.model
    maxForks = 2
    requestTimeout = '180 sec'
    time = '10 min'
    // A string lets Nextflow append the Docker mapping for its driver connection.
    containerOptions = "-v '${params.codex_home.toString().replace("'", "'\\''")}:/opt/codex-home' --user \$(id -u):\$(id -g)"
}

profiles {
    shell {
        agent.containerOptions = "-v '${params.codex_home.toString().replace("'", "'\\''")}:/opt/codex-home' --user \$(id -u):\$(id -g) --security-opt seccomp=unconfined"
    }
}
