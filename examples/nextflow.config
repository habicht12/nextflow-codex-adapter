plugins { id 'nf-agent-codex@0.1.0' }

params.model = 'openai/gpt-6-luna'
params.codex_home = "${env('HOME')}/.local/state/nf-agent-codex"

docker.enabled = true
agent {
    runner = 'codex'
    model = params.model
    maxForks = 2
    requestTimeout = '180 sec'
    time = '10 min'
    containerOptions = {
        def login = params.codex_home.toString()
        if (!login.startsWith('/') || login.contains("'") || login.contains('\n'))
            error('codex_home must be an absolute path without apostrophes or newlines')
        "-v '${login}:/opt/codex-home' --user \$(id -u):\$(id -g)"
    }
}

profiles {
    shell {
        agent.containerOptions = {
            def login = params.codex_home.toString()
            if (!login.startsWith('/') || login.contains("'") || login.contains('\n'))
                error('codex_home must be an absolute path without apostrophes or newlines')
            "-v '${login}:/opt/codex-home' --user \$(id -u):\$(id -g) --security-opt seccomp=unconfined"
        }
    }
}
